{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parameter key publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "microserviceIdentifiers"
  ],
  "properties": {
    "identifiers": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "maxLength": 36
      }
    },
    "microserviceIdentifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "maxLength": 36
      }
    },
    "all": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "all": {
            "const": true
          }
        },
        "required": [
          "all"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "identifiers"
        ],
        "properties": {
          "identifiers": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
