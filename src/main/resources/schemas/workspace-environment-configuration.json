{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settings",
    "publishers"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisherIdentifier",
          "sortOrder",
          "parameters"
        ],
        "properties": {
          "publisherIdentifier": {
            "type": "string",
            "format": "uuid"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "environmentIdentifier": {
      "type": "string",
      "format": "uuid"
    }
  },
  "if": {
    "required": [
      "version"
    ],
    "properties": {
      "version": {
        "type": "integer"
      }
    }
  },
  "then": {
    "not": {
      "required": [
        "environmentIdentifier"
      ]
    }
  },
  "else": {
    "required": [
      "environmentIdentifier"
    ]
  }
}
