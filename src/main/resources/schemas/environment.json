{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "authorizationType",
    "settings",
    "environmentTypeCode"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "authorizationType": {
      "type": "string",
      "enum": [
        "DEV",
        "TST",
        "ADM"
      ],
      "maxLength": 50
    },
    "sortOrder": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 2147483647
    },
    "authorizerGroup": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 253
    },
    "settings": {
      "type": "object",
      "description": "Environment-specific settings; properties are configurable by the platform.",
      "additionalProperties": true
    },
    "parentIdentifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "environmentTypeCode": {
      "type": "string",
      "enum": ["DEFAULT", "CUSTOM", "SHARD", "CELL"],
      "maxLength": 50
    }
  }
}
