{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settings",
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisherIdentifier",
          "sortOrder",
          "parameters"
        ],
        "properties": {
          "publisherIdentifier": {
            "type": "string",
            "format": "uuid"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "copyWorkspacePublishers": {
      "type": "boolean",
      "default": false
    }
  },
  "if": {
    "required": [
      "copyWorkspacePublishers"
    ],
    "properties": {
      "copyWorkspacePublishers": {
        "const": true
      }
    }
  },
  "then": {
    "not": {
      "required": [
        "publishers"
      ]
    }
  },
  "else": {
    "required": [
      "publishers"
    ]
  }
}
