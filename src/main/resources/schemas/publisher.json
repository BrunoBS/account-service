{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Publisher request",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "description",
        "scope",
        "settings",
        "code"
    ],
    "properties": {
        "code": {
            "type": "string",
            "enum": [
                "KAFKA",
                "WEB_SOCKET",
                "APP_CONFIG"
            ],
            "maxLength": 50
        },
        "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "\\S"
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
        },
        "scope": {
            "type": "string",
            "enum": [
                "WORKSPACE",
                "APPLICATION"
            ],
            "maxLength": 50
        },
        "deprecated": {
            "type": "boolean"
        },
        "settings": {
            "type": "object"
        },
        "version": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "code": {
                        "const": "KAFKA"
                    }
                },
                "required": [
                    "code"
                ]
            },
            "then": {
                "properties": {
                    "settings": {
                        "type": "object",
                        "required": [
                            "topic",
                            "address"
                        ],
                        "properties": {
                            "topic": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 249,
                                "pattern": "\\S"
                            },
                            "address": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 1000,
                                "pattern": "\\S"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "code": {
                        "const": "APP_CONFIG"
                    }
                },
                "required": [
                    "code"
                ]
            },
            "then": {
                "properties": {
                    "settings": {
                        "type": "object",
                        "required": [
                            "arn",
                            "name"
                        ],
                        "properties": {
                            "arn": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048,
                                "pattern": "\\S"
                            },
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "\\S"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "code": {
                        "const": "WEB_SOCKET"
                    }
                },
                "required": [
                    "code"
                ]
            },
            "then": {
                "properties": {
                    "settings": {
                        "type": "object",
                        "required": [
                            "clientId",
                            "timeout"
                        ],
                        "properties": {
                            "clientId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100,
                                "pattern": "\\S"
                            },
                            "timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 60000,
                                "description": "Timeout in milliseconds."
                            }
                        },
                        "additionalProperties": false
                    }
                }
            }
        }
    ]
}
