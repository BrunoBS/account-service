{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateWorkspaceEnvironmentConfigurationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settings",
    "publishers"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "environmentIdentifier": {
      "type": "string",
      "format": "uuid"
    },
    "settings": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "WebSocket Publisher",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisherCode",
              "sortOrder",
              "parameters"
            ],
            "properties": {
              "publisherCode": {
                "type": "string",
                "const": "WEB_SOCKET"
              },
              "sortOrder": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clientId"
                ],
                "properties": {
                  "clientId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "title": "Kafka Publisher",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisherCode",
              "sortOrder",
              "parameters"
            ],
            "properties": {
              "publisherCode": {
                "type": "string",
                "const": "KAFKA"
              },
              "sortOrder": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "topicName"
                ],
                "properties": {
                  "topicName": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "title": "AppConfig Publisher",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisherCode",
              "sortOrder",
              "parameters"
            ],
            "properties": {
              "publisherCode": {
                "type": "string",
                "const": "APP_CONFIG"
              },
              "sortOrder": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "arn",
                  "contaAWS"
                ],
                "properties": {
                  "arn": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contaAWS": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "environmentIdentifier"
          ]
        }
      },
      "else": {
        "required": [
          "environmentIdentifier"
        ]
      }
    }
  ]
}