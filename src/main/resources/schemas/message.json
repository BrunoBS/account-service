{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "microserviceIdentifier",
    "messageKey",
    "code",
    "httpStatus"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "microserviceIdentifier": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "messageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
    },
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "pattern": "^[A-Z][A-Z0-9-]{2,49}$"
    },
    "httpStatus": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "observation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "translators": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "title",
          "detail",
          "suggestion"
        ],
        "properties": {
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "\\S"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "translators"
          ]
        }
      }
    }
  ]
}
