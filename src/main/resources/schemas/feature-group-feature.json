{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Feature Group associations request",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "featureIdentifiers"
    ],
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
        },
        "featureIdentifiers": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "string",
                "format": "uuid"
            }
        }
    }
}
