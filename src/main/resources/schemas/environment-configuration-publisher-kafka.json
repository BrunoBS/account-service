{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisherIdentifier",
    "sortOrder",
    "parameters"
  ],
  "properties": {
    "publisherIdentifier": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
