{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration publication batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifiers"],
  "properties": {
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid", "maxLength": 36}
    }
  }
}
