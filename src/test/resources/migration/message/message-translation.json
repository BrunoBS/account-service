{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message translation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "title",
    "detail",
    "suggestion"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "suggestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  }
}
