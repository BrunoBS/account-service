{
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "alias", "acronym", "applicationScope"],
  "properties": {
    "version": {"type": ["integer", "null"], "minimum": 0},
    "name": {"type": "string", "minLength": 3, "maxLength": 50},
    "alias": {"type": "string", "minLength": 1, "maxLength": 50},
    "acronym": {"type": "string", "minLength": 1, "maxLength": 5},
    "description": {"type": "string", "maxLength": 200},
    "applicationScope": {"type": "string", "enum": ["BACKEND", "FRONTEND", "SHARED"]},
    "authorizerGroup": {"type": ["string", "null"], "minLength": 1, "maxLength": 10},
    "settings": {"type": "object", "additionalProperties": true},
    "tags": {
      "type": ["array", "null"],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  }
}
