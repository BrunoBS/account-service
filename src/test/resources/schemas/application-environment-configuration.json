{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "if": {"required": ["settings"]},
  "then": {
    "additionalProperties": false,
    "required": ["settings"],
    "properties": {
      "version": {"type": ["integer", "null"], "minimum": 0},
      "environmentIdentifier": {"type": "string", "format": "uuid"},
      "settings": {"type": "object", "additionalProperties": true},
      "publishers": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisherCode", "sortOrder", "parameters"],
          "properties": {
            "publisherCode": {"type": "string", "enum": ["WEB_SOCKET", "KAFKA", "APP_CONFIG"]},
            "sortOrder": {"type": "integer", "minimum": 1},
            "parameters": {"type": "object", "additionalProperties": true}
          }
        }
      },
      "copyWorkspacePublishers": {"type": "boolean", "default": false}
    },
    "allOf": [
      {
        "if": {"required": ["environmentIdentifier"]},
        "then": {"properties": {"version": {"type": "null"}}},
        "else": {"required": ["version"], "properties": {"version": {"type": "integer"}}}
      },
      {
        "if": {"required": ["copyWorkspacePublishers"], "properties": {"copyWorkspacePublishers": {"const": true}}},
        "then": {"not": {"required": ["publishers"]}},
        "else": {"required": ["publishers"]}
      }
    ]
  },
  "else": {
    "additionalProperties": true
  }
}
